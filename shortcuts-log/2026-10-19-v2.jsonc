    "args": {
      "keyName": "closeFindWidget (alt+e)",
      "command": "closeFindWidget",
      "priority": "primary",
      "group": "universal-escape/close-widget",
    },
    "when": "editorFocus && findWidgetVisible && !isComposing",
  },
  {
    "key": "alt+e",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "closeMarkersNavigation (alt+e)",
      "command": "closeMarkersNavigation",
      "priority": "secondary",
      "group": "universal-escape/close-widget",
    },
    "when": "editorFocus && markersNavigationVisible",
  },
  {
    "key": "alt+e",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "closeParameterHints (alt+e)",
      "command": "closeParameterHints",
      "priority": "secondary",
      "group": "universal-escape/close-widget",
    },
    "when": "editorFocus && parameterHintsVisible",
  },
  {
    "key": "alt+e",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "closeReferenceSearch (alt+e)",
      "command": "closeReferenceSearch",
      "priority": "primary",
      "group": "universal-escape/close-widget",
    },
    "when": "referenceSearchVisible",
  },

  // 6-2. 入力・選択のキャンセル
  {
    "key": "alt+e",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "cancelRenameInput (alt+e)",
      "command": "cancelRenameInput",
      "priority": "primary",
      "group": "universal-escape/cancel-selection",
    },
    "when": "editorFocus && renameInputVisible",
  },
  {
    "key": "alt+e",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "cancelSelection (alt+e)",
      "command": "cancelSelection",
      "priority": "primary",
      "group": "universal-escape/cancel-selection",
    },
    "when": "editorHasSelection && textInputFocus && !selectionAnchorSet",
  },
  {
    "key": "alt+e",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.files.action.focusFilesExplorer:cancelRename (alt+e)",
      "command": "workbench.files.action.focusFilesExplorer",
      "priority": "secondary",
      "group": "universal-escape/cancel-selection",
    },
    "when": "explorerViewletVisible && filesExplorerFocus && inputFocus",
  },

  // 6-3. モード離脱・サジェスト非表示
  {
    "key": "alt+e",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.inlineSuggest.hide (alt+e)",
      "command": "editor.action.inlineSuggest.hide",
      "priority": "primary",
      "group": "universal-escape/dismiss-suggest",
    },
    "when": "inlineSuggestVisible && textInputFocus",
  },
  {
    "key": "alt+e",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "hideCodeActionWidget (alt+e)",
      "command": "hideCodeActionWidget",
      "priority": "secondary",
      "group": "universal-escape/dismiss-suggest",
    },
    "when": "codeActionMenuVisible",
  },
  {
    "key": "alt+e",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "hideSuggestWidget (alt+e)",
      "command": "hideSuggestWidget",
      "priority": "primary",
      "group": "universal-escape/dismiss-suggest",
    },
    "when": "suggestWidgetVisible && textInputFocus",
  },
  {
    "key": "alt+e",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "quickInput.hide (alt+e)",
      "command": "quickInput.hide",
      "priority": "primary",
      "group": "universal-escape/dismiss-suggest",
    },
    "when": "inQuickInput",
  },
  {
    "key": "alt+e",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "leaveSnippet (alt+e)",
      "command": "leaveSnippet",
      "priority": "primary",
      "group": "universal-escape/dismiss-suggest",
    },
    "when": "inSnippetMode && textInputFocus",
  },
  {
    "key": "alt+e",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "removeSecondaryCursors (alt+e)",
      "command": "removeSecondaryCursors",
      "priority": "core",
      "group": "universal-escape/dismiss-suggest",
    },
    "when": "editorHasMultipleSelections && textInputFocus",
  },
  {
    "key": "alt+e",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "list.clear (alt+e)",
      "command": "list.clear",
      "priority": "secondary",
      "group": "universal-escape/dismiss-suggest",
    },
    "when": "listFocus && listMultiSelection && !inputFocus && !treestickyScrollFocused",
  },
  {
    "key": "alt+e",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.action.focusActiveEditorGroup (alt+e)",
      "command": "workbench.action.focusActiveEditorGroup",
      "priority": "primary",
      "group": "universal-escape/dismiss-suggest",
    },
    "when": "(sideBarFocus || auxiliaryBarFocus) && !listMultiSelection && !renameInputVisible",
  },
  //#endregion

  //#region Module 7: 【エディタ・ウィンドウ・ワークスペース】
  // 7-1. エディタタブ操作
  {
    "key": "alt+w",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.action.closeActiveEditor (alt+w)",
      "command": "workbench.action.closeActiveEditor",
      "priority": "primary",
      "group": "workbench/editor-tab",
    },
  },
  {
    "key": "shift+alt+w",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.action.reopenClosedEditor (shift+alt+w)",
      "command": "workbench.action.reopenClosedEditor",
      "priority": "primary",
      "group": "workbench/editor-tab",
    },
  },
  {
    "key": "ctrl+alt+w",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.action.closeEditorsInGroup (ctrl+alt+w)",
      "command": "workbench.action.closeEditorsInGroup",
      "priority": "secondary",
      "group": "workbench/editor-tab",
    },
  },
  {
    "key": "alt+t",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.action.nextEditorInGroup (alt+t)",
      "command": "workbench.action.nextEditorInGroup",
      "priority": "primary",
      "group": "workbench/editor-tab",
    },
  },
  {
    "key": "shift+alt+t",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "previousEditorInGroup (shift+alt+t)",
      "command": "workbench.action.previousEditorInGroup",
      "priority": "primary",
      "group": "workbench/editor-tab",
    },
  },
  {
    "key": "ctrl+alt+t",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.action.lastEditorInGroup (ctrl+alt+t)",
      "command": "workbench.action.lastEditorInGroup",
      "priority": "tertiary",
      "group": "workbench/editor-tab",
    },
  },

  // 7-2. 画面分割 & グループフォーカス
  {
    "key": "shift+alt+f shift+alt+l",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.action.splitEditor (shift+alt+f shift+alt+l)",
      "command": "workbench.action.splitEditor",
      "priority": "secondary",
      "group": "workbench/split-group",
    },
  },
  {
    "key": "shift+alt+f shift+alt+h",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.action.closeGroup (shift+alt+f shift+alt+h)",
      "command": "workbench.action.closeGroup",
      "priority": "secondary",
      "group": "workbench/split-group",
    },
  },
  {
    "key": "alt+f alt+l",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.action.focusRightGroup (alt+f alt+l)",
      "command": "workbench.action.focusRightGroup",
      "priority": "secondary",
      "group": "workbench/split-group",
    },
    "when": "!findInputFocussed",
  },
  {
    "key": "alt+f alt+h",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.action.focusLeftGroup (alt+f alt+h)",
      "command": "workbench.action.focusLeftGroup",
      "priority": "secondary",
      "group": "workbench/split-group",
    },
  },
  {
    "key": "ctrl+alt+f ctrl+alt+j",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.action.focusBelowGroup (ctrl+alt+f ctrl+alt+j)",
      "command": "workbench.action.focusBelowGroup",
      "priority": "tertiary",
      "group": "workbench/split-group",
    },
    "when": "!inSnippetMode",
  },
  {
    "key": "ctrl+alt+f ctrl+alt+k",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.action.focusAboveGroup (ctrl+alt+f ctrl+alt+k)",
      "command": "workbench.action.focusAboveGroup",
      "priority": "tertiary",
      "group": "workbench/split-group",
    },
    "when": "!inSnippetMode",
  },

  // 7-3. コマンド・クイックオープン
  {
    "key": "alt+q",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.action.quickOpen (alt+q)",
      "command": "workbench.action.quickOpen",
      "priority": "primary",
      "group": "workbench/quick-open",
    },
  },
  {
    "key": "alt+q",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "quickOpenSelectNextAndAccept (alt+q)",
      "command": "runCommands",
      "commandArgs": {
        "commands": [
          "workbench.action.quickOpenSelectNext",
          "workbench.action.acceptSelectedQuickOpenItem",
        ],
      },
      "priority": "secondary",
      "group": "workbench/quick-open",
      "keep": true,
    },
    "when": "inQuickOpen",
  },
  {
    "key": "shift+alt+q",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.action.gotoSymbol (shift+alt+q)",
      "command": "workbench.action.gotoSymbol",
      "priority": "primary",
      "group": "workbench/quick-open",
    },
  },
  {
    "key": "ctrl+alt+q",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.action.showAllSymbols (ctrl+alt+q)",
      "command": "workbench.action.showAllSymbols",
      "priority": "secondary",
      "group": "workbench/quick-open",
    },
  },
  {
    "key": "alt+f alt+q",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.action.showCommands (alt+f alt+q)",
      "command": "workbench.action.showCommands",
      "priority": "primary",
      "group": "workbench/quick-open",
    },
  },

  //  7-4. サイドバー・パネル管理
  {
    "key": "alt+f alt+j",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.action.focusActiveEditorGroup (alt+f alt+j)",
      "command": "workbench.action.focusActiveEditorGroup",
      "priority": "secondary",
      "group": "workbench/sidebar-panel",
    },
    "when": "panelFocus",
  },
  {
    "key": "alt+f alt+j",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.action.focusPanel (alt+f alt+j)",
      "command": "workbench.action.focusPanel",
      "priority": "secondary",
      "group": "workbench/sidebar-panel",
    },
    "when": "!panelFocus",
  },
  {
    "key": "shift+alt+f shift+alt+j",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.action.togglePanel (shift+alt+f shift+alt+j)",
      "command": "workbench.action.togglePanel",
      "priority": "secondary",
      "group": "workbench/sidebar-panel",
    },
  },
  {
    "key": "alt+f alt+e",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.action.toggleSidebarVisibility (alt+f alt+e)",
      "command": "workbench.action.toggleSidebarVisibility",
      "priority": "secondary",
      "group": "workbench/sidebar-panel",
    },
    "when": "sideBarFocus && activeViewlet == 'workbench.view.explorer'",
  },
  {
    "key": "alt+f alt+e",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.view.explorer (alt+f alt+e)",
      "command": "workbench.view.explorer",
      "priority": "secondary",
      "group": "workbench/sidebar-panel",
    },
    "when": "!sideBarFocus || activeViewlet != 'workbench.view.explorer'",
  },
  {
    "key": "alt+f alt+g",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.action.toggleSidebarVisibility (alt+f alt+g)",
      "command": "workbench.action.toggleSidebarVisibility",
      "priority": "secondary",
      "group": "workbench/sidebar-panel",
    },
    "when": "sideBarFocus && activeViewlet == 'workbench.view.scm' && inputFocus",
  },
  {
    "key": "alt+f alt+g",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.scm.action.focusNextInput (alt+f alt+g)",
      "command": "workbench.scm.action.focusNextInput",
      "priority": "secondary",
      "group": "workbench/sidebar-panel",
    },
    "when": "sideBarFocus && activeViewlet == 'workbench.view.scm' && !inputFocus",
  },
  {
    "key": "alt+f alt+g",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.view.scm (alt+f alt+g)",
      "command": "workbench.view.scm",
      "priority": "secondary",
      "group": "workbench/sidebar-panel",
    },
    "when": "!sideBarFocus || activeViewlet != 'workbench.view.scm'",
  },
  {
    "key": "alt+f alt+s",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.action.toggleSidebarVisibility (alt+f alt+s)",
      "command": "workbench.action.toggleSidebarVisibility",
      "priority": "secondary",
      "group": "workbench/sidebar-panel",
    },
    "when": "sideBarFocus && activeViewlet == 'workbench.view.search' && inputFocus",
  },
  {
    "key": "alt+f alt+s",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.action.findInFiles (alt+f alt+s)",
      "command": "workbench.action.findInFiles",
      "priority": "secondary",
      "group": "workbench/sidebar-panel",
    },
    "when": "!sideBarFocus || activeViewlet != 'workbench.view.search' || !inputFocus",
  },
  {
    "key": "shift+alt+f shift+alt+s",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.action.toggleSidebarVisibility (shift+alt+f shift+alt+s)",
      "command": "workbench.action.toggleSidebarVisibility",
      "priority": "secondary",
      "group": "workbench/sidebar-panel",
    },
    "when": "sideBarFocus && activeViewlet == 'workbench.view.search' && inputFocus",
  },
  {
    "key": "shift+alt+f shift+alt+s",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.action.replaceInFiles (shift+alt+f shift+alt+s)",
      "command": "workbench.action.replaceInFiles",
      "priority": "secondary",
      "group": "workbench/sidebar-panel",
    },
    "when": "!sideBarFocus || activeViewlet != 'workbench.view.search' || !inputFocus",
  },
  {
    "key": "alt+f alt+b",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.action.toggleSidebarVisibility (alt+f alt+b)",
      "command": "workbench.action.toggleSidebarVisibility",
      "priority": "secondary",
      "group": "workbench/sidebar-panel",
    },
    "when": "sideBarFocus",
  },
  {
    "key": "alt+f alt+b",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.action.focusSideBar (alt+f alt+b)",
      "command": "workbench.action.focusSideBar",
      "priority": "secondary",
      "group": "workbench/sidebar-panel",
    },
    "when": "!sideBarFocus",
  },
  {
    "key": "shift+alt+f shift+alt+b",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.action.toggleAuxiliaryBar (shift+alt+f shift+alt+b)",
      "command": "workbench.action.toggleAuxiliaryBar",
      "priority": "secondary",
      "group": "workbench/sidebar-panel",
    },
  },
  //#endregion

  //#region Module 8: 【エクスプローラー】
  // 8-1. エクスプローラー内 ファイル操作
  {
    "key": "alt+n",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "explorer.newFile (alt+n)",
      "command": "explorer.newFile",
      "priority": "primary",
      "group": "explorer/file-operation",
    },
    "when": "filesExplorerFocus && foldersViewVisible && !inputFocus",
  },
  {
    "key": "shift+alt+n",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "explorer.newFolder (shift+alt+n)",
      "command": "explorer.newFolder",
      "priority": "primary",
      "group": "explorer/file-operation",
    },
    "when": "filesExplorerFocus && foldersViewVisible && !inputFocus",
  },
  {
    "key": "ctrl+alt+n",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "newFileWithBaseName (ctrl+alt+n)",
      "command": "runCommands",
      "commandArgs": {
        "commands": [
          "renameFile",
          "editor.action.clipboardCopyAction",
          "explorer.newFile",
          "editor.action.clipboardPasteAction",
        ],
      },
      "priority": "secondary",
      "group": "explorer/file-operation",
    },
    "when": "filesExplorerFocus && foldersViewVisible && !inputFocus",
  },
  {
    "key": "alt+f alt+n",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "duplicateAndRenameFile (alt+f alt+n)",
      "command": "runCommands",
      "commandArgs": {
        "commands": ["filesExplorer.copy", "filesExplorer.paste", "renameFile"],
      },
      "priority": "secondary",
      "group": "explorer/file-operation",
    },
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus",
  },
  {
    "key": "alt+r",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "renameFile (alt+r)",
      "command": "renameFile",
      "priority": "primary",
      "group": "explorer/file-operation",
    },
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus",
  },
  {
    "key": "alt+r",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.selectAll:fileName (alt+r)",
      "command": "editor.action.selectAll",
      "priority": "primary",
      "group": "explorer/file-operation",
    },
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && inputFocus",
  },
  {
    "key": "alt+f alt+y",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "filesExplorer.copy (alt+f alt+y)",
      "command": "filesExplorer.copy",
      "priority": "secondary",
      "group": "explorer/file-operation",
    },
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !inputFocus",
  },
  {
    "key": "alt+f alt+p",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "filesExplorer.paste (alt+f alt+p)",
      "command": "filesExplorer.paste",
      "priority": "secondary",
      "group": "explorer/file-operation",
    },
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceReadonly && !inputFocus",
  },
  {
    "key": "alt+f alt+d",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "filesExplorer.cut (alt+f alt+d)",
      "command": "filesExplorer.cut",
      "priority": "secondary",
      "group": "explorer/file-operation",
    },
    "when": "!explorerResourceCut && filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus",
  },
  {
    "key": "alt+f alt+d",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "filesExplorer.cancelCut (alt+f alt+d)",
      "command": "filesExplorer.cancelCut",
      "priority": "secondary",
      "group": "explorer/file-operation",
    },
    "when": "explorerResourceCut && filesExplorerFocus && foldersViewVisible && !inputFocus",
  },
  {
    "key": "alt+f alt+v",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "moveFileToTrash (alt+f alt+v)",
      "command": "moveFileToTrash",
      "priority": "secondary",
      "group": "explorer/file-operation",
    },
    "when": "explorerResourceMoveableToTrash && filesExplorerFocus && foldersViewVisible && !inputFocus",
  },

  // 8-2. パス取得 & OS連携
  {
    "key": "alt+y",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "copyFileName (alt+y)",
      "command": "runCommands",
      "commandArgs": {
        "commands": [
          "renameFile",
          "editor.action.selectAll",
          "editor.action.clipboardCopyAction",
          "workbench.files.action.focusFilesExplorer",
        ],
      },
      "priority": "secondary",
      "group": "explorer/path-os-integration",
    },
    "when": "filesExplorerFocus && !inputFocus",
  },
  {
    "key": "shift+alt+y",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "copyRelativeFilePath (shift+alt+y)",
      "command": "copyRelativeFilePath",
      "priority": "secondary",
      "group": "explorer/path-os-integration",
    },
    "when": "filesExplorerFocus && !inputFocus",
  },
  {
    "key": "ctrl+alt+y",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "copyFilePath (ctrl+alt+y)",
      "command": "copyFilePath",
      "priority": "secondary",
      "group": "explorer/path-os-integration",
    },
    "when": "filesExplorerFocus && !inputFocus",
  },
  {
    "key": "alt+o",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.action.files.openFile (alt+o)",
      "command": "workbench.action.files.openFile",
      "priority": "secondary",
      "group": "explorer/path-os-integration",
    },
    "when": "filesExplorerFocus && !editorFocus",
  },
  {
    "key": "shift+alt+o",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.action.files.openFolder (shift+alt+o)",
      "command": "workbench.action.files.openFolder",
      "priority": "secondary",
      "group": "explorer/path-os-integration",
    },
    "when": "openFolderWorkspaceSupport && filesExplorerFocus && !editorFocus",
  },
  {
    "key": "ctrl+alt+o",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "revealFileInOS (ctrl+alt+o)",
      "command": "revealFileInOS",
      "priority": "secondary",
      "group": "explorer/path-os-integration",
    },
    "when": "openFolderWorkspaceSupport && filesExplorerFocus && !editorFocus",
  },
  {
    "key": "alt+l",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "nextCompressedFolder (alt+l)",
      "command": "nextCompressedFolder",
      "priority": "tertiary",
      "group": "explorer/path-os-integration",
    },
    "when": "filesExplorerFocus && foldersViewVisible && !inputFocus && !treestickyScrollFocused",
  },
  {
    "key": "alt+h",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "previousCompressedFolder (alt+h)",
      "command": "previousCompressedFolder",
      "priority": "tertiary",
      "group": "explorer/path-os-integration",
    },
    "when": "filesExplorerFocus && foldersViewVisible && !inputFocus && !treestickyScrollFocused",
  },
  //#endregion

  //#region Module 9: 【開発支援・コード実行】
  // 9-1. インテリセンス & コードアクション・シンボル
  {
    "key": "alt+m",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.triggerSuggest (alt+m)",
      "command": "editor.action.triggerSuggest",
      "priority": "primary",
      "group": "development/intellisense",
    },
    "when": "editorHasCompletionItemProvider && textInputFocus && !editorReadonly && !suggestWidgetVisible && !renameInputVisible && !codeActionMenuVisible && !findInputFocussed && !replaceInputFocussed",
  },
  {
    "key": "shift+alt+m",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.quickFix (shift+alt+m)",
      "command": "editor.action.quickFix",
      "priority": "primary",
      "group": "development/intellisense",
    },
    "when": "editorHasCodeActionsProvider && textInputFocus && !editorReadonly",
  },
  {
    "key": "ctrl+alt+m",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.showHover (ctrl+alt+m)",
      "command": "editor.action.showHover",
      "priority": "primary",
      "group": "development/intellisense",
    },
    "when": "editorTextFocus && !editorHoverVisible",
  },
  {
    "key": "ctrl+shift+alt+m",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.triggerParameterHints (ctrl+shift+alt+m)",
      "command": "editor.action.triggerParameterHints",
      "priority": "secondary",
      "group": "development/intellisense",
    },
    "when": "editorHasSignatureHelpProvider && textInputFocus",
  },
  {
    "key": "ctrl+alt+o",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.rename (ctrl+alt+o)",
      "command": "editor.action.rename",
      "priority": "primary",
      "group": "development/intellisense",
    },
    "when": "editorHasRenameProvider && editorTextFocus && !editorReadonly",
  },
  {
    "key": "ctrl+shift+alt+o",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.refactor (ctrl+shift+alt+o)",
      "command": "editor.action.refactor",
      "priority": "secondary",
      "group": "development/intellisense",
    },
    "when": "editorHasCodeActionsProvider && textInputFocus && !editorReadonly",
  },

  // 9-2. エラー・Git差分ジャンプ
  {
    "key": "alt+,",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.marker.next:initial (alt+,)",
      "command": "runCommands",
      "commandArgs": {
        "commands": ["cursorLineStart", "editor.action.marker.next"],
      },
      "priority": "primary",
      "group": "development/diagnostic-jump",
      "keep": true,
    },
    "when": "editorFocus && !markersNavigationVisible",
  },
  {
    "key": "alt+,",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.marker.next (alt+,)",
      "command": "editor.action.marker.next",
      "priority": "primary",
      "group": "development/diagnostic-jump",
    },
    "when": "editorFocus && markersNavigationVisible",
  },
  {
    "key": "shift+alt+,",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.marker.prev (shift+alt+,)",
      "command": "editor.action.marker.prev",
      "priority": "primary",
      "group": "development/diagnostic-jump",
    },
    "when": "editorFocus",
  },
  {
    "key": "ctrl+alt+,",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.action.editor.nextChange (ctrl+alt+,)",
      "command": "workbench.action.editor.nextChange",
      "priority": "secondary",
      "group": "development/diagnostic-jump",
    },
    "when": "editorTextFocus && !textCompareEditorActive && quickDiffDecorationCount != '0'",
  },
  {
    "key": "ctrl+shift+alt+,",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.action.editor.previousChange (ctrl+shift+alt+,)",
      "command": "workbench.action.editor.previousChange",
      "priority": "secondary",
      "group": "development/diagnostic-jump",
    },
    "when": "editorTextFocus && !textCompareEditorActive && quickDiffDecorationCount != '0'",
  },

  // 9-3. コード整形 & スニペット操作
  {
    "key": "alt+f alt+f",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.formatDocument (alt+f alt+f)",
      "command": "editor.action.formatDocument",
      "priority": "primary",
      "group": "development/format-snippet",
    },
    "when": "editorHasDocumentFormattingProvider && editorTextFocus && !editorReadonly && !inCompositeEditor",
  },
  {
    "key": "alt+f alt+f",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.formatDocument.none (alt+f alt+f)",
      "command": "editor.action.formatDocument.none",
      "priority": "primary",
      "group": "development/format-snippet",
    },
    "when": "editorTextFocus && !editorHasDocumentFormattingProvider && !editorReadonly",
  },
  {
    "key": "alt+f alt+m",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "jumpToNextSnippetPlaceholder (alt+f alt+m)",
      "command": "jumpToNextSnippetPlaceholder",
      "priority": "secondary",
      "group": "development/format-snippet",
    },
    "when": "hasNextTabstop && inSnippetMode && textInputFocus",
  },
  {
    "key": "shift+alt+f shift+alt+m",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "jumpToPrevSnippetPlaceholder (shift+alt+f shift+alt+m)",
      "command": "jumpToPrevSnippetPlaceholder",
      "priority": "secondary",
      "group": "development/format-snippet",
    },
    "when": "hasPrevTabstop && inSnippetMode && textInputFocus",
  },

  // 9-4. コード実行 (Code Runner連携)
  {
    "key": "alt+f alt+enter",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "code-runner.run (alt+f alt+enter)",
      "command": "code-runner.run",
      "priority": "primary",
      "group": "development/code-execution",
    },
    "when": "editorTextFocus",
  },
  {
    "key": "shift+alt+f shift+alt+enter",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "code-runner.stop (shift+alt+f shift+alt+enter)",
      "command": "code-runner.stop",
      "priority": "secondary",
      "group": "development/code-execution",
    },
  },
  //#endregion

  // --- 自動追加検出用セパレーター（GUI等でキーバインドを追加した際に下部へ追記される目印） ---
  {
    "key": "-",
  },
]
