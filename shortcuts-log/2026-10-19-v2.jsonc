[
  //#region 基底レイヤー: 【システム競合解除 & 追跡】
  // 0-1. プレフィックスキー保護 (base/prefix-protection)
  { "key": "alt+f", "command": "noop" },

  // 0-2. デフォルトショートカット無効化 (base/disable-defaults)
  {
    "key": "alt+w",
    "command": "-toggleFindWholeWord",
    "when": "editorFocus",
  },
  {
    "key": "alt+r",
    "command": "-toggleFindRegex",
    "when": "editorFocus",
  },
  {
    "key": "alt+c",
    "command": "-toggleFindCaseSensitive",
    "when": "editorFocus",
  },
  {
    "key": "alt+c",
    "command": "-toggleSearchCaseSensitive",
    "when": "searchViewletFocus",
  },
  {
    "key": "alt+l",
    "command": "-toggleFindInSelection",
    "when": "editorFocus",
  },
  {
    "key": "shift+alt+i",
    "command": "-editor.action.insertCursorAtEndOfEachLineSelected",
    "when": "editorTextFocus",
  },
  {
    "key": "ctrl+alt+i",
    "command": "-workbench.action.chat.open",
    "when": "!chatSetupDisabledInWorkspace && !chatSetupHidden",
  },
  {
    "key": "ctrl+alt+n",
    "command": "-code-runner.run",
  },
  {
    "key": "ctrl+alt+m",
    "command": "-code-runner.stop",
  },
  {
    "key": "ctrl+alt+b",
    "command": "-workbench.action.toggleAuxiliaryBar",
  },
  {
    "key": "ctrl+alt+o",
    "command": "-workbench.action.remote.showMenu",
  },
  // {
  //   "key": "ctrl+shift+alt+l",
  //   "command": "-workbench.action.quickchat.toggle",
  //   "when": "chatIsEnabled",
  // },
  // {
  //   "key": "alt+0",
  //   "command": "-workbench.action.lastEditorInGroup",
  // },

  // 0-3. ロガー追跡（Tracker専用）
  {
    "key": "ctrl+v",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.clipboardPasteAction (ctrl+v)",
      "command": "editor.action.clipboardPasteAction",
      "priority": "tertiary",
      "group": "base/tracker-logging",
    },
  },
  {
    "key": "ctrl+c",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.clipboardCopyAction (ctrl+c)",
      "command": "editor.action.clipboardCopyAction",
      "priority": "tertiary",
      "group": "base/tracker-logging",
    },
  },
  {
    "key": "ctrl+a",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.selectAll (ctrl+a)",
      "command": "editor.action.selectAll",
      "priority": "tertiary",
      "group": "base/tracker-logging",
    },
  },
  {
    "key": "ctrl+d",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.addSelectionToNextFindMatch (ctrl+d)",
      "command": "editor.action.addSelectionToNextFindMatch",
      "priority": "tertiary",
      "group": "base/tracker-logging",
    },
    "when": "editorFocus",
  },
  {
    "key": "ctrl+s",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.action.files.save (ctrl+s)",
      "command": "workbench.action.files.save",
      "priority": "tertiary",
      "group": "base/tracker-logging",
    },
  },
  {
    "key": "ctrl+x",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.clipboardCutAction (ctrl+x)",
      "command": "editor.action.clipboardCutAction",
      "priority": "tertiary",
      "group": "base/tracker-logging",
    },
  },
  {
    "key": "ctrl+z",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "undo (ctrl+z)",
      "command": "undo",
      "priority": "tertiary",
      "group": "base/tracker-logging",
    },
  },
  {
    "key": "ctrl+y",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "redo (ctrl+y)",
      "command": "redo",
      "priority": "tertiary",
      "group": "base/tracker-logging",
    },
  },
  {
    "key": "ctrl+w",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.action.closeActiveEditor (ctrl+w)",
      "command": "workbench.action.closeActiveEditor",
      "priority": "tertiary",
      "group": "base/tracker-logging",
    },
  },
  {
    "key": "ctrl+q",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.action.quickOpenView (ctrl+q)",
      "command": "workbench.action.quickOpenView",
      "priority": "tertiary",
      "group": "base/tracker-logging",
    },
  },
  //#endregion

  //#region Module 1: 【HJKL ナビゲーション】
  // 1-1. 基本カーソル移動
  {
    "key": "alt+h",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "cursorLeft (alt+h)",
      "command": "cursorLeft",
      "priority": "primary",
      "group": "navigation/basic-cursor",
    },
  },
  {
    "key": "shift+alt+h",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "cursorWordLeft (shift+alt+h)",
      "command": "cursorWordLeft",
      "priority": "primary",
      "group": "navigation/basic-cursor",
    },
    "when": "textInputFocus && !editorHasSelection",
  },
  {
    "key": "shift+alt+h",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "cursorLeft (shift+alt+h)",
      "command": "cursorLeft",
      "priority": "primary",
      "group": "navigation/basic-cursor",
    },
    "when": "textInputFocus && editorHasSelection",
  },
  {
    "key": "alt+l",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "cursorRight (alt+l)",
      "command": "cursorRight",
      "priority": "primary",
      "group": "navigation/basic-cursor",
    },
  },
  {
    "key": "shift+alt+l",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "cursorWordEndRight (shift+alt+l)",
      "command": "cursorWordEndRight",
      "priority": "primary",
      "group": "navigation/basic-cursor",
    },
    "when": "textInputFocus && !editorHasSelection",
  },
  {
    "key": "shift+alt+l",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "cursorRight (shift+alt+l)",
      "command": "cursorRight",
      "priority": "primary",
      "group": "navigation/basic-cursor",
    },
    "when": "textInputFocus && editorHasSelection",
  },
  {
    "key": "alt+k",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "cursorUp (alt+k)",
      "command": "cursorUp",
      "priority": "primary",
      "group": "navigation/basic-cursor",
    },
    "when": "textInputFocus",
  },
  {
    "key": "alt+j",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "cursorDown (alt+j)",
      "command": "cursorDown",
      "priority": "primary",
      "group": "navigation/basic-cursor",
    },
    "when": "textInputFocus",
  },
  {
    "key": "ctrl+alt+h",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "cursorHome (ctrl+alt+h)",
      "command": "cursorHome",
      "priority": "primary",
      "group": "navigation/basic-cursor",
    },
    "when": "textInputFocus",
  },
  {
    "key": "ctrl+alt+l",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "cursorEnd (ctrl+alt+l)",
      "command": "cursorEnd",
      "priority": "primary",
      "group": "navigation/basic-cursor",
    },
    "when": "textInputFocus",
  },

  // 1-2. リスト・ポップアップ移動
  {
    "key": "alt+k",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "list.focusUp (alt+k)",
      "command": "list.focusUp",
      "priority": "primary",
      "group": "navigation/list-popup",
    },
    "when": "listFocus && !inputFocus && !treestickyScrollFocused",
  },
  {
    "key": "alt+j",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "list.focusDown (alt+j)",
      "command": "list.focusDown",
      "priority": "primary",
      "group": "navigation/list-popup",
    },
    "when": "listFocus && !inputFocus && !treestickyScrollFocused",
  },
  {
    "key": "shift+alt+k",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "list.expandSelectionUp (shift+alt+k)",
      "command": "list.expandSelectionUp",
      "priority": "secondary",
      "group": "navigation/list-popup",
    },
    "when": "listFocus && listSupportsMultiselect && !inputFocus && !treestickyScrollFocused",
  },
  {
    "key": "shift+alt+j",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "list.expandSelectionDown (shift+alt+j)",
      "command": "list.expandSelectionDown",
      "priority": "secondary",
      "group": "navigation/list-popup",
    },
    "when": "listFocus && listSupportsMultiselect && !inputFocus && !treestickyScrollFocused",
  },
  {
    "key": "ctrl+alt+k",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "list.focusPageUp (ctrl+alt+k)",
      "command": "list.focusPageUp",
      "priority": "secondary",
      "group": "navigation/list-popup",
    },
    "when": "listFocus && !inputFocus && !treestickyScrollFocused",
  },
  {
    "key": "ctrl+alt+j",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "list.focusPageDown (ctrl+alt+j)",
      "command": "list.focusPageDown",
      "priority": "secondary",
      "group": "navigation/list-popup",
    },
    "when": "listFocus && !inputFocus && !treestickyScrollFocused",
  },
  {
    "key": "alt+k",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "selectPrevSuggestion (alt+k)",
      "command": "selectPrevSuggestion",
      "priority": "primary",
      "group": "navigation/list-popup",
    },
    "when": "suggestWidgetMultipleSuggestions && suggestWidgetVisible && textInputFocus || suggestWidgetVisible && textInputFocus && !suggestWidgetHasFocusedSuggestion",
  },
  {
    "key": "alt+j",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "selectNextSuggestion (alt+j)",
      "command": "selectNextSuggestion",
      "priority": "primary",
      "group": "navigation/list-popup",
    },
    "when": "suggestWidgetMultipleSuggestions && suggestWidgetVisible && textInputFocus || suggestWidgetVisible && textInputFocus && !suggestWidgetHasFocusedSuggestion",
  },
  {
    "key": "alt+k",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "focusPreviousRenameSuggestion (alt+k)",
      "command": "focusPreviousRenameSuggestion",
      "priority": "secondary",
      "group": "navigation/list-popup",
    },
    "when": "renameInputVisible",
  },
  {
    "key": "alt+j",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "focusNextRenameSuggestion (alt+j)",
      "command": "focusNextRenameSuggestion",
      "priority": "secondary",
      "group": "navigation/list-popup",
    },
    "when": "renameInputVisible",
  },
  {
    "key": "alt+k",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "quickInput.previous (alt+k)",
      "command": "quickInput.previous",
      "priority": "primary",
      "group": "navigation/list-popup",
    },
    "when": "inQuickInput && quickInputType == 'quickPick' || inQuickInput && quickInputType == 'quickTree'",
  },
  {
    "key": "alt+j",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "quickInput.next (alt+j)",
      "command": "quickInput.next",
      "priority": "primary",
      "group": "navigation/list-popup",
    },
    "when": "inQuickInput && quickInputType == 'quickPick' || inQuickInput && quickInputType == 'quickTree'",
  },
  {
    "key": "alt+k",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "selectPrevCodeAction (alt+k)",
      "command": "selectPrevCodeAction",
      "priority": "primary",
      "group": "navigation/list-popup",
    },
    "when": "codeActionMenuVisible",
  },
  {
    "key": "alt+j",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "selectNextCodeAction (alt+j)",
      "command": "selectNextCodeAction",
      "priority": "primary",
      "group": "navigation/list-popup",
    },
    "when": "codeActionMenuVisible",
  },
  {
    "key": "alt+j",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "search.action.focusSearchList (alt+j)",
      "command": "search.action.focusSearchList",
      "priority": "secondary",
      "group": "navigation/list-popup",
    },
    "when": "searchViewletVisible && searchViewletFocus && inputFocus",
  },
  {
    "key": "alt+j",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.scm.action.focusNextResourceGroup (alt+j)",
      "command": "workbench.scm.action.focusNextResourceGroup",
      "priority": "secondary",
      "group": "navigation/list-popup",
    },
    "when": "sideBarFocus && activeViewlet == 'workbench.view.scm' && inputFocus",
  },

  // 1-3. スクロール & 画面ジャンプ
  {
    "key": "shift+alt+k",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editorScroll:up (shift+alt+k)",
      "command": "editorScroll",
      "commandArgs": {
        "to": "up",
        "by": "wrappedLine",
        "value": 10,
        "revealCursor": false,
      },
      "priority": "primary",
      "group": "navigation/scroll-jump",
    },
    "when": "textInputFocus && !inReferenceSearchEditor",
  },
  {
    "key": "shift+alt+j",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editorScroll:down (shift+alt+j)",
      "command": "editorScroll",
      "commandArgs": {
        "to": "down",
        "by": "wrappedLine",
        "value": 10,
        "revealCursor": false,
      },
      "priority": "primary",
      "group": "navigation/scroll-jump",
    },
    "when": "textInputFocus && !inReferenceSearchEditor",
  },
  {
    "key": "shift+alt+k",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editorScroll:refup (shift+alt+k)",
      "command": "editorScroll",
      "commandArgs": {
        "to": "up",
        "by": "wrappedLine",
        "value": 4,
        "revealCursor": false,
      },
      "priority": "secondary",
      "group": "navigation/scroll-jump",
    },
    "when": "inReferenceSearchEditor && !editorReadonly",
  },
  {
    "key": "shift+alt+j",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editorScroll:refdown (shift+alt+j)",
      "command": "editorScroll",
      "commandArgs": {
        "to": "down",
        "by": "wrappedLine",
        "value": 4,
        "revealCursor": false,
      },
      "priority": "secondary",
      "group": "navigation/scroll-jump",
    },
    "when": "inReferenceSearchEditor && !editorReadonly",
  },
  {
    "key": "alt+enter",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "jumpToViewPortMiddle (alt+enter)",
      "command": "runCommands",
      "commandArgs": {
        "commands": [
          "workbench.action.focusActiveEditorGroup",
          {
            "command": "cursorMove",
            "args": {
              "to": "viewPortTop",
              "by": "wrappedLine",
            },
          },
          // viewPortCenter は fold 中のコードの影響を受けて画面の中央に飛べない + foldされたコードを勝手に開いてしまう
          // foldの影響を受けるか、画面サイズを変えたときに中央に飛べなくなるかのトレードオフ
          {
            "command": "cursorMove",
            "args": { "to": "down", "value": 19, "by": "wrappedLine" },
          },
          {
            "command": "cursorEnd",
          },
        ],
      },
      "priority": "primary",
      "group": "navigation/scroll-jump",
    },
    "when": "(editorTextFocus || sideBarFocus || auxiliaryBarFocus) && !findInputFocussed && !inReferenceSearchEditor",
  },
  {
    "key": "alt+enter",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "jumpToPeekMiddle (alt+enter)",
      "command": "runCommands",
      "commandArgs": {
        "commands": [
          {
            "command": "cursorMove",
            "args": {
              "to": "viewPortTop",
              "by": "wrappedLine",
            },
          },
          {
            "command": "cursorMove",
            "args": { "to": "down", "value": 5, "by": "wrappedLine" },
          },
          {
            "command": "cursorEnd",
          },
        ],
      },
      "priority": "secondary",
      "group": "navigation/scroll-jump",
    },
    "when": "editorTextFocus && !findInputFocussed && inReferenceSearchEditor",
  },
  {
    "key": "shift+alt+enter",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "cursorTop (shift+alt+enter)",
      "command": "cursorTop",
      "priority": "primary",
      "group": "navigation/basic-cursor",
    },
    "when": "textInputFocus",
  },
  {
    "key": "ctrl+alt+enter",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "cursorBottom (ctrl+alt+enter)",
      "command": "cursorBottom",
      "priority": "primary",
      "group": "navigation/basic-cursor",
    },
    "when": "textInputFocus",
  },
  {
    "key": "ctrl+alt+k",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "cursorMove:prevBlankLine (ctrl+alt+k)",
      "command": "cursorMove",
      "commandArgs": {
        "to": "prevBlankLine",
      },
      "priority": "secondary",
      "group": "navigation/scroll-jump",
    },
    "when": "editorTextFocus",
  },
  {
    "key": "ctrl+alt+j",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "cursorMove:nextBlankLine (ctrl+alt+j)",
      "command": "cursorMove",
      "commandArgs": {
        "to": "nextBlankLine",
      },
      "priority": "secondary",
      "group": "navigation/scroll-jump",
    },
    "when": "editorTextFocus",
  },

  // 1-4. ナビゲーション履歴
  {
    "key": "alt+r",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.action.navigateBack (alt+r)",
      "command": "workbench.action.navigateBack",
      "priority": "primary",
      "group": "navigation/history",
    },
    "when": "canNavigateBack",
  },
  {
    "key": "shift+alt+r",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.action.navigateForward (shift+alt+r)",
      "command": "workbench.action.navigateForward",
      "priority": "primary",
      "group": "navigation/history",
    },
    "when": "canNavigateForward",
  },
  //#endregion

  //#region Module 2: 【アンカー選択・確定アクション】
  // 2-1. アンカー設置
  {
    "key": "alt+a",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.setSelectionAnchor (alt+a)",
      "command": "editor.action.setSelectionAnchor",
      "priority": "core",
      "group": "anchor-selection/set-anchor",
    },
    "when": "editorTextFocus && !selectionAnchorSet",
  },
  {
    "key": "shift+alt+a",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "setLineStartAnchor (shift+alt+a)",
      "command": "runCommands",
      "commandArgs": {
        "commands": [
          "cursorLineStart",
          "editor.action.setSelectionAnchor",
          "cursorUndo",
        ],
      },
      "priority": "secondary",
      "group": "anchor-selection/set-anchor",
    },
    "when": "editorTextFocus && !selectionAnchorSet",
  },

  // 2-2. 通常確定アクション（カーソル位置まで）
  {
    "key": "alt+a",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.selectFromAnchorToCursor (alt+a)",
      "command": "editor.action.selectFromAnchorToCursor",
      "priority": "core",
      "group": "anchor-selection/cursor-action",
    },
    "when": "editorTextFocus && selectionAnchorSet",
  },
  {
    "key": "alt+y",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "copyFromAnchor (alt+y)",
      "command": "runCommands",
      "commandArgs": {
        "commands": [
          "editor.action.selectFromAnchorToCursor",
          "editor.action.clipboardCopyAction",
        ],
      },
      "priority": "primary",
      "group": "anchor-selection/cursor-action",
    },
    "when": "editorTextFocus && selectionAnchorSet",
  },
  {
    "key": "alt+d",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "cutFromAnchor (alt+d)",
      "command": "runCommands",
      "commandArgs": {
        "commands": [
          "editor.action.selectFromAnchorToCursor",
          "editor.action.clipboardCutAction",
        ],
      },
      "priority": "primary",
      "group": "anchor-selection/cursor-action",
    },
    "when": "editorTextFocus && selectionAnchorSet",
  },
  {
    "key": "alt+n",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "deleteFromAnchor (alt+n)",
      "command": "runCommands",
      "commandArgs": {
        "commands": ["editor.action.selectFromAnchorToCursor", "deleteLeft"],
      },
      "priority": "primary",
      "group": "anchor-selection/cursor-action",
    },
    "when": "editorTextFocus && selectionAnchorSet",
  },
  {
    "key": "alt+v",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "deleteLinesFromAnchor (alt+v)",
      "command": "runCommands",
      "commandArgs": {
        "commands": [
          "editor.action.selectFromAnchorToCursor",
          "editor.action.deleteLines",
        ],
      },
      "priority": "secondary",
      "group": "anchor-selection/cursor-action",
    },
    "when": "editorTextFocus && selectionAnchorSet",
  },
  {
    "key": "alt+p",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "pasteFromAnchor (alt+p)",
      "command": "runCommands",
      "commandArgs": {
        "commands": [
          "editor.action.selectFromAnchorToCursor",
          "editor.action.clipboardPasteAction",
        ],
      },
      "priority": "secondary",
      "group": "anchor-selection/cursor-action",
    },
    "when": "editorTextFocus && selectionAnchorSet",
  },

  // 2-3. 行末確定アクション（改行を含めて行全体を即時実行）
  {
    "key": "shift+alt+a",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "selectLinesToCurrentLineEndFromAnchor (shift+alt+a)",
      "command": "runCommands",
      "commandArgs": {
        "commands": [
          "editor.action.selectFromAnchorToCursor",
          "expandLineSelection",
          "cursorLeftSelect",
        ],
      },
      "priority": "primary",
      "group": "anchor-selection/line-action",
      "keep": true,
    },
    "when": "editorTextFocus && selectionAnchorSet",
  },
  {
    "key": "shift+alt+y",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "copyLinesFromAnchor (shift+alt+y)",
      "command": "runCommands",
      "commandArgs": {
        "commands": [
          "editor.action.selectFromAnchorToCursor",
          "expandLineSelection",
          "cursorLeftSelect",
          "editor.action.clipboardCopyAction",
        ],
      },
      "priority": "primary",
      "group": "anchor-selection/line-action",
    },
    "when": "editorTextFocus && selectionAnchorSet",
  },
  {
    "key": "shift+alt+d",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "cutLinesFromAnchor (shift+alt+d)",
      "command": "runCommands",
      "commandArgs": {
        "commands": [
          "editor.action.selectFromAnchorToCursor",
          "expandLineSelection",
          "editor.action.clipboardCutAction",
        ],
      },
      "priority": "primary",
      "group": "anchor-selection/line-action",
    },
    "when": "editorTextFocus && selectionAnchorSet",
  },
  {
    "key": "shift+alt+n",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "deleteLinesFromAnchor (shift+alt+n)",
      "command": "runCommands",
      "commandArgs": {
        "commands": [
          "editor.action.selectFromAnchorToCursor",
          "expandLineSelection",
          "deleteLeft",
        ],
      },
      "priority": "primary",
      "group": "anchor-selection/line-action",
    },
    "when": "editorTextFocus && selectionAnchorSet",
  },
  {
    "key": "shift+alt+p",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "pasteLinesFromAnchor (shift+alt+p)",
      "command": "runCommands",
      "commandArgs": {
        "commands": [
          "editor.action.selectFromAnchorToCursor",
          "expandLineSelection",
          "cursorLeftSelect",
          "editor.action.clipboardPasteAction",
        ],
      },
      "priority": "secondary",
      "group": "anchor-selection/line-action",
    },
    "when": "editorTextFocus && selectionAnchorSet",
  },

  // 2-4. アンカー連動 検索・コメント
  {
    "key": "alt+s",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "findInSelectionFromAnchor (alt+s)",
      "command": "runCommands",
      "commandArgs": {
        "commands": [
          "editor.action.selectFromAnchorToCursor",
          "expandLineSelection",
          {
            "command": "editor.actions.findWithArgs",
            "args": {
              "findInSelection": true,
            },
          },
        ],
      },
      "priority": "secondary",
      "group": "anchor-selection/search-comment",
    },
    "when": "editorTextFocus && selectionAnchorSet",
  },
  {
    "key": "shift+alt+s",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "replaceInSelectionFromAnchor (shift+alt+s)",
      "command": "runCommands",
      "commandArgs": {
        "commands": [
          "editor.action.selectFromAnchorToCursor",
          {
            "command": "editor.actions.findWithArgs",
            "args": {
              "findInSelection": true,
              "replaceString": "",
            },
          },
        ],
      },
      "priority": "secondary",
      "group": "anchor-selection/search-comment",
    },
    "when": "editorTextFocus && selectionAnchorSet",
  },
  {
    "key": "alt+/",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "commentLineFromAnchor (alt+/)",
      "command": "runCommands",
      "commandArgs": {
        "commands": [
          "editor.action.selectFromAnchorToCursor",
          "editor.action.commentLine",
          "cancelSelection",
        ],
      },
      "priority": "secondary",
      "group": "anchor-selection/search-comment",
    },
    "when": "editorTextFocus && selectionAnchorSet",
  },
  {
    "key": "shift+alt+/",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "blockCommentFromAnchor (shift+alt+/)",
      "command": "runCommands",
      "commandArgs": {
        "commands": [
          "editor.action.selectFromAnchorToCursor",
          "editor.action.blockComment",
        ],
      },
      "priority": "secondary",
      "group": "anchor-selection/search-comment",
    },
    "when": "editorTextFocus && selectionAnchorSet",
  },

  // 2-5. アンカー解除
  {
    "key": "alt+e",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.cancelSelectionAnchor (alt+e)",
      "command": "editor.action.cancelSelectionAnchor",
      "priority": "core",
      "group": "anchor-selection/cancel-anchor",
    },
    "when": "editorTextFocus && selectionAnchorSet",
  },
  //#endregion

  //#region Module 3: 【ホームポジション テキスト編集・削除】
  // 3-1. 物理・単語削除 (B / N系)
  {
    "key": "alt+b",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "deleteLeft (alt+b)",
      "command": "deleteLeft",
      "priority": "primary",
      "group": "text-editing/delete-char-word",
    },
    "when": "textInputFocus && !selectionAnchorSet",
  },
  {
    "key": "shift+alt+b",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "deleteRight (shift+alt+b)",
      "command": "deleteRight",
      "priority": "primary",
      "group": "text-editing/delete-char-word",
    },
    "when": "textInputFocus && !selectionAnchorSet",
  },
  {
    "key": "ctrl+alt+b",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "deleteSubWord (ctrl+alt+b)",
      "command": "runCommands",
      "commandArgs": {
        "commands": ["editor.action.smartSelect.expand", "deleteLeft"],
      },
      "priority": "secondary",
      "group": "text-editing/delete-char-word",
    },
    "when": "editorTextFocus && !editorReadonly && !editorHasSelection",
  },
  {
    "key": "ctrl+alt+b",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "deleteLeft:selection (ctrl+alt+b)",
      "command": "deleteLeft",
      "priority": "secondary",
      "group": "text-editing/delete-char-word",
    },
    "when": "editorTextFocus && !editorReadonly && editorHasSelection",
  },
  {
    "key": "alt+n",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "deleteWordLeft (alt+n)",
      "command": "deleteWordLeft",
      "priority": "primary",
      "group": "text-editing/delete-char-word",
    },
    "when": "textInputFocus && !selectionAnchorSet",
  },
  {
    "key": "shift+alt+n",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "deleteWordRight (shift+alt+n)",
      "command": "deleteWordRight",
      "priority": "primary",
      "group": "text-editing/delete-char-word",
    },
    "when": "textInputFocus && !selectionAnchorSet",
  },
  {
    "key": "ctrl+alt+n",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "deleteCurrentWord (ctrl+alt+n)",
      "command": "runCommands",
      "commandArgs": {
        "commands": ["editor.action.addSelectionToNextFindMatch", "deleteLeft"],
      },
      "priority": "secondary",
      "group": "text-editing/delete-char-word",
    },
    "when": "editorTextFocus && !editorReadonly && !editorHasSelection",
  },
  {
    "key": "ctrl+alt+n",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "deleteLeft:selection (ctrl+alt+n)",
      "command": "deleteLeft",
      "priority": "secondary",
      "group": "text-editing/delete-char-word",
    },
    "when": "editorTextFocus && !editorReadonly && editorHasSelection",
  },
  {
    "key": "alt+f alt+n",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "deleteAllLeft (alt+f alt+n)",
      "command": "deleteAllLeft",
      "priority": "secondary",
      "group": "text-editing/delete-char-word",
    },
    "when": "editorTextFocus && !editorReadonly",
  },
  {
    "key": "shift+alt+f shift+alt+n",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "deleteAllRight (shift+alt+f shift+alt+n)",
      "command": "deleteAllRight",
      "priority": "secondary",
      "group": "text-editing/delete-char-word",
    },
    "when": "editorTextFocus && !editorReadonly",
  },

  // 3-2. 行削除 (V系)
  {
    "key": "alt+v",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.deleteLines (alt+v)",
      "command": "editor.action.deleteLines",
      "priority": "primary",
      "group": "text-editing/delete-line",
    },
    "when": "textInputFocus && !editorReadonly && !selectionAnchorSet",
  },
  {
    "key": "shift+alt+v",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "clearLineContent (shift+alt+v)",
      "command": "runCommands",
      "commandArgs": {
        "commands": ["cursorHome", "deleteAllRight"],
      },
      "priority": "secondary",
      "group": "text-editing/delete-line",
    },
    "when": "textInputFocus && !editorReadonly && !editorHasSelection && !selectionAnchorSet",
  },
  {
    "key": "shift+alt+v",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "replaceSelectionWithEmptyLine (shift+alt+v)",
      "command": "runCommands",
      "commandArgs": {
        "commands": [
          "editor.action.deleteLines",
          "editor.action.insertLineBefore",
        ],
      },
      "priority": "secondary",
      "group": "text-editing/delete-line",
    },
    "when": "textInputFocus && !editorReadonly && editorHasSelection && !selectionAnchorSet",
  },

  // 3-3. クリップボード操作 (Y / P / D系)
  {
    "key": "alt+y",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.clipboardCopyAction (alt+y)",
      "command": "editor.action.clipboardCopyAction",
      "priority": "primary",
      "group": "text-editing/clipboard",
    },
    "when": "!selectionAnchorSet",
  },
  {
    "key": "alt+d",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.clipboardCutAction (alt+d)",
      "command": "editor.action.clipboardCutAction",
      "priority": "primary",
      "group": "text-editing/clipboard",
    },
    "when": "!selectionAnchorSet",
  },
  {
    "key": "alt+p",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.clipboardPasteAction (alt+p)",
      "command": "editor.action.clipboardPasteAction",
      "priority": "primary",
      "group": "text-editing/clipboard",
    },
    "when": "!selectionAnchorSet",
  },
  // --- 未選択時：単語単位の操作 ---
  {
    "key": "shift+alt+y",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "copyCurrentWord (shift+alt+y)",
      "command": "runCommands",
      "commandArgs": {
        "commands": [
          "editor.action.addSelectionToNextFindMatch",
          "editor.action.clipboardCopyAction",
        ],
      },
      "priority": "secondary",
      "group": "text-editing/clipboard",
    },
    "when": "editorTextFocus && !editorHasSelection && !selectionAnchorSet",
  },
  {
    "key": "shift+alt+d",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "cutCurrentWord (shift+alt+d)",
      "command": "runCommands",
      "commandArgs": {
        "commands": [
          "editor.action.addSelectionToNextFindMatch",
          "editor.action.clipboardCutAction",
        ],
      },
      "priority": "secondary",
      "group": "text-editing/clipboard",
    },
    "when": "editorTextFocus && !editorHasSelection && !selectionAnchorSet",
  },
  {
    "key": "shift+alt+p",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "replaceCurrentWordWithPaste (shift+alt+p)",
      "command": "runCommands",
      "commandArgs": {
        "commands": [
          "editor.action.addSelectionToNextFindMatch",
          "editor.action.clipboardPasteAction",
        ],
      },
      "priority": "secondary",
      "group": "text-editing/clipboard",
    },
    "when": "editorTextFocus && !editorHasSelection && !selectionAnchorSet",
  },
  // --- 選択時：行単位の操作 ---
  {
    "key": "shift+alt+y",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "copyEntireLine (shift+alt+y)",
      "command": "runCommands",
      "commandArgs": {
        "commands": [
          "expandLineSelection",
          "cursorLeftSelect",
          "editor.action.clipboardCopyAction",
        ],
      },
      "priority": "secondary",
      "group": "text-editing/clipboard",
    },
    "when": "editorTextFocus && editorHasSelection && !selectionAnchorSet",
  },
  {
    "key": "shift+alt+d",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "cutEntireLine (shift+alt+d)",
      "command": "runCommands",
      "commandArgs": {
        "commands": ["expandLineSelection", "editor.action.clipboardCutAction"],
      },
      "priority": "secondary",
      "group": "text-editing/clipboard",
    },
    "when": "editorTextFocus && !editorReadonly && editorHasSelection && !selectionAnchorSet",
  },
  {
    "key": "shift+alt+p",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "pasteEntireLine (shift+alt+p)",
      "command": "runCommands",
      "commandArgs": {
        "commands": [
          "expandLineSelection",
          "cursorLeftSelect",
          "editor.action.clipboardPasteAction",
        ],
      },
      "priority": "secondary",
      "group": "text-editing/clipboard",
    },
    "when": "editorTextFocus && !editorReadonly && editorHasSelection && !selectionAnchorSet",
  },
  // ペースト(P)の拡張
  {
    "key": "ctrl+alt+p",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "pasteEntireLine (ctrl+alt+p)",
      "command": "runCommands",
      "commandArgs": {
        "commands": [
          "expandLineSelection",
          "cursorLeftSelect",
          "editor.action.clipboardPasteAction",
        ],
      },
      "priority": "primary",
      "group": "text-editing/clipboard",
      "keep": true,
    },
    "when": "editorTextFocus && !editorReadonly && !selectionAnchorSet",
  },
  {
    "key": "alt+f alt+p",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "insertLineAndPaste (alt+f alt+p)",
      "command": "runCommands",
      "commandArgs": {
        "commands": [
          "editor.action.insertLineAfter",
          "editor.action.clipboardPasteAction",
        ],
      },
      "priority": "secondary",
      "group": "text-editing/clipboard",
    },
    "when": "editorTextFocus && !editorReadonly && !selectionAnchorSet",
  },

  // 3-4. 全域クリップボード操作 (C系)
  {
    "key": "alt+c",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "copyAllContent (alt+c)",
      "command": "runCommands",
      "commandArgs": {
        "commands": [
          "editor.action.selectAll",
          "editor.action.clipboardCopyAction",
        ],
      },
      "priority": "primary",
      "group": "text-editing/document-clipboard",
      "keep": true,
    },
    "when": "editorTextFocus",
  },
  {
    "key": "shift+alt+c",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "pasteReplaceAllContent (shift+alt+c)",
      "command": "runCommands",
      "commandArgs": {
        "commands": [
          "editor.action.selectAll",
          "editor.action.clipboardPasteAction",
          "editor.action.formatDocument",
          "workbench.action.files.save",
        ],
      },
      "priority": "primary",
      "group": "text-editing/document-clipboard",
      "keep": true,
    },
    "when": "editorTextFocus && !editorReadonly",
  },

  // 3-5. 行操作 & コード構造
  {
    "key": "alt+[Quote]",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.insertLineBefore (alt+[Quote])",
      "command": "editor.action.insertLineBefore",
      "priority": "primary",
      "group": "text-editing/line-structure",
    },
    "when": "editorTextFocus && !editorReadonly",
  },
  {
    "key": "alt+[Semicolon]",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.insertLineAfter (alt+[Semicolon])",
      "command": "editor.action.insertLineAfter",
      "priority": "primary",
      "group": "text-editing/line-structure",
    },
    "when": "editorTextFocus && !editorReadonly",
  },
  {
    "key": "shift+alt+[Quote]",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.copyLinesUpAction (shift+alt+[Quote])",
      "command": "editor.action.copyLinesUpAction",
      "priority": "primary",
      "group": "text-editing/line-structure",
    },
    "when": "editorTextFocus && !editorReadonly",
  },
  {
    "key": "shift+alt+[Semicolon]",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.copyLinesDownAction (shift+alt+[Semicolon])",
      "command": "editor.action.copyLinesDownAction",
      "priority": "primary",
      "group": "text-editing/line-structure",
    },
    "when": "editorTextFocus && !editorReadonly",
  },
  {
    "key": "ctrl+alt+[Quote]",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.moveLinesUpAction (ctrl+alt+[Quote])",
      "command": "editor.action.moveLinesUpAction",
      "priority": "primary",
      "group": "text-editing/line-structure",
    },
    "when": "editorTextFocus && !editorReadonly",
  },
  {
    "key": "ctrl+alt+[Semicolon]",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.moveLinesDownAction (ctrl+alt+[Semicolon])",
      "command": "editor.action.moveLinesDownAction",
      "priority": "primary",
      "group": "text-editing/line-structure",
    },
    "when": "editorTextFocus && !editorReadonly",
  },
  {
    "key": "ctrl+shift+alt+[Quote]",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "joinLinesUpward (ctrl+shift+alt+[Quote])",
      "command": "runCommands",
      "commandArgs": {
        "commands": ["cursorUp", "editor.action.joinLines"],
      },
      "priority": "tertiary",
      "group": "text-editing/line-structure",
    },
    "when": "editorTextFocus && !editorReadonly",
  },
  {
    "key": "ctrl+shift+alt+[Semicolon]",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.joinLines (ctrl+shift+alt+[Semicolon])",
      "command": "editor.action.joinLines",
      "priority": "secondary",
      "group": "text-editing/line-structure",
    },
    "when": "editorTextFocus && !editorReadonly",
  },

  // 3-6. コード折りたたみ・展開（単体・再帰・全体）
  {
    "key": "alt+f alt+[Quote]",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.fold (alt+f alt+[Quote])",
      "command": "editor.fold",
      "priority": "secondary",
      "group": "text-editing/code-folding",
    },
    "when": "editorTextFocus && foldingEnabled",
  },
  {
    "key": "alt+f alt+[Semicolon]",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.unfold (alt+f alt+[Semicolon])",
      "command": "editor.unfold",
      "priority": "secondary",
      "group": "text-editing/code-folding",
    },
    "when": "editorTextFocus && foldingEnabled",
  },
  {
    "key": "shift+alt+f shift+alt+[Quote]",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.foldRecursively (shift+alt+f shift+alt+[Quote])",
      "command": "editor.foldRecursively",
      "priority": "tertiary",
      "group": "text-editing/code-folding",
    },
    "when": "editorTextFocus && foldingEnabled",
  },
  {
    "key": "shift+alt+f shift+alt+[Semicolon]",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.unfoldRecursively (shift+alt+f shift+alt+[Semicolon])",
      "command": "editor.unfoldRecursively",
      "priority": "tertiary",
      "group": "text-editing/code-folding",
    },
    "when": "editorTextFocus && foldingEnabled",
  },
  {
    "key": "ctrl+alt+f ctrl+alt+[Quote]",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.foldAll (ctrl+alt+f ctrl+alt+[Quote])",
      "command": "editor.foldAll",
      "priority": "secondary",
      "group": "text-editing/code-folding",
    },
    "when": "editorTextFocus && foldingEnabled",
  },
  {
    "key": "ctrl+alt+f ctrl+alt+[Semicolon]",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.unfoldAll (ctrl+alt+f ctrl+alt+[Semicolon])",
      "command": "editor.unfoldAll",
      "priority": "secondary",
      "group": "text-editing/code-folding",
    },
    "when": "editorTextFocus && foldingEnabled",
  },

  // 3-7. コメント操作
  {
    "key": "alt+/",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.commentLine (alt+/)",
      "command": "editor.action.commentLine",
      "priority": "primary",
      "group": "text-editing/comment",
    },
    "when": "editorTextFocus && !editorReadonly && !selectionAnchorSet",
  },
  {
    "key": "shift+alt+/",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.blockComment (shift+alt+/)",
      "command": "editor.action.blockComment",
      "priority": "secondary",
      "group": "text-editing/comment",
    },
    "when": "editorTextFocus && !editorReadonly && !selectionAnchorSet",
  },
  {
    "key": "alt+f alt+/",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "commentSelectionAtLineEnd (alt+f alt+/)",
      "command": "runCommands",
      "commandArgs": {
        "commands": [
          "editor.action.clipboardCutAction",
          "cursorEnd",
          {
            "command": "editor.action.insertSnippet",
            "args": {
              "snippet": " ${1:$CLIPBOARD}$0",
            },
          },
          "editor.action.blockComment",
          "cursorLeft",
          "cursorWordLeft",
          "cursorWordLeft",
        ],
      },
      "priority": "tertiary",
      "group": "text-editing/comment",
    },
    "when": "editorHasSelection && editorTextFocus && !editorReadonly",
  },
  {
    "key": "alt+f alt+/",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "extractLineEndComment (alt+f alt+/)",
      "command": "runCommands",
      "commandArgs": {
        "commands": [
          "cursorLineEnd",
          "editor.action.blockComment",
          "editor.action.clipboardCutAction",
          "cursorWordLeft",
          "cursorWordLeft",
        ],
      },
      "priority": "tertiary",
      "group": "text-editing/comment",
    },
    "when": "!editorHasSelection && editorTextFocus && !editorReadonly",
  },

  // 3-8. スマート範囲選択 & 一致選択 (O / I系)
  {
    "key": "alt+o",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.smartSelect.expand (alt+o)",
      "command": "editor.action.smartSelect.expand",
      "priority": "primary",
      "group": "text-editing/smart-selection",
    },
    "when": "editorTextFocus",
  },
  {
    "key": "shift+alt+o",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.smartSelect.shrink (shift+alt+o)",
      "command": "editor.action.smartSelect.shrink",
      "priority": "primary",
      "group": "text-editing/smart-selection",
    },
    "when": "editorTextFocus",
  },
  {
    "key": "alt+f alt+o",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.selectToBracket:initial (alt+f alt+o)",
      "command": "editor.action.selectToBracket",
      "commandArgs": {
        "selectBrackets": false,
      },
      "priority": "secondary",
      "group": "text-editing/smart-selection",
    },
    "when": "editorTextFocus && !editorHasSelection",
  },
  {
    "key": "alt+f alt+o",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.selectToBracket:extend (alt+f alt+o)",
      "command": "editor.action.selectToBracket",
      "commandArgs": {
        "selectBrackets": true,
      },
      "priority": "secondary",
      "group": "text-editing/smart-selection",
    },
    "when": "editorTextFocus && editorHasSelection",
  },
  // JS / C / Java / JSON など区切りに{}を使う言語で活躍
  {
    "key": "shift+alt+f shift+alt+o",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "selectEnclosingBlock (shift+alt+f shift+alt+o)",
      "command": "runCommands",
      "commandArgs": {
        "commands": [
          {
            "command": "editor.action.selectToBracket",
            "args": {
              "selectBrackets": false,
            },
          },
          "editor.action.smartSelect.expand",
          "editor.action.smartSelect.expand",
          "expandLineSelection",
        ],
      },
      "priority": "secondary",
      "group": "text-editing/smart-selection",
    },
    "when": "editorTextFocus",
  },
  {
    "key": "alt+i",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.addSelectionToNextFindMatch (alt+i)",
      "command": "editor.action.addSelectionToNextFindMatch",
      "priority": "primary",
      "group": "text-editing/smart-selection",
    },
    "when": "editorFocus && !selectionAnchorSet",
  },
  {
    "key": "shift+alt+i",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "cursorUndo (shift+alt+i)",
      "command": "cursorUndo",
      "priority": "primary",
      "group": "text-editing/smart-selection",
    },
    "when": "editorFocus",
  },
  {
    "key": "ctrl+alt+i",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "expandLineSelection (ctrl+alt+i)",
      "command": "expandLineSelection",
      "priority": "secondary",
      "group": "text-editing/smart-selection",
    },
    "when": "editorFocus",
  },
  {
    "key": "alt+f alt+i",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.selectHighlights (alt+f alt+i)",
      "command": "editor.action.selectHighlights",
      "priority": "primary",
      "group": "text-editing/smart-selection",
    },
    "when": "editorFocus",
  },

  // 3-9. マルチカーソル追加・複数行編集 (A系)
  {
    "key": "alt+f alt+a",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "insertCursorAtEndOfEachLine (alt+f alt+a)",
      "command": "runCommands",
      "commandArgs": {
        "commands": [
          "editor.action.insertCursorAtEndOfEachLineSelected",
          "cursorLineEnd",
        ],
      },
      "priority": "primary",
      "group": "text-editing/multi-cursor",
    },
    "when": "!selectionAnchorSet && editorTextFocus",
  },
  {
    "key": "shift+alt+f shift+alt+a",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "insertCursorAtHomeOfEachLine (shift+alt+f shift+alt+a)",
      "command": "runCommands",
      "commandArgs": {
        "commands": [
          "editor.action.insertCursorAtEndOfEachLineSelected",
          "cursorLineStart",
          "cursorHome",
        ],
      },
      "priority": "secondary",
      "group": "text-editing/multi-cursor",
    },
    "when": "!selectionAnchorSet && editorTextFocus",
  },
  {
    "key": "alt+f alt+a",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "anchorInsertCursorAtEndOfEachLine (alt+f alt+a)",
      "command": "runCommands",
      "commandArgs": {
        "commands": [
          "editor.action.selectFromAnchorToCursor",
          "editor.action.insertCursorAtEndOfEachLineSelected",
          "cursorLineEnd",
        ],
      },
      "priority": "primary",
      "group": "text-editing/multi-cursor",
    },
    "when": "selectionAnchorSet && editorTextFocus",
  },
  {
    "key": "shift+alt+f shift+alt+a",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "anchorInsertCursorAtHomeOfEachLine (shift+alt+f shift+alt+a)",
      "command": "runCommands",
      "commandArgs": {
        "commands": [
          "editor.action.selectFromAnchorToCursor",
          "editor.action.insertCursorAtEndOfEachLineSelected",
          "cursorLineStart",
          "cursorHome",
        ],
      },
      "priority": "secondary",
      "group": "text-editing/multi-cursor",
    },
    "when": "selectionAnchorSet && editorTextFocus",
  },
  {
    "key": "alt+i",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "addSelectionFromAnchorToNextFindMatch (alt+i)",
      "command": "runCommands",
      "commandArgs": {
        "commands": [
          "editor.action.selectFromAnchorToCursor",
          "editor.action.addSelectionToNextFindMatch",
        ],
      },
      "priority": "secondary",
      "group": "text-editing/multi-cursor",
    },
    "when": "editorFocus && selectionAnchorSet",
  },

  // 3-10. 編集補助・履歴・保存
  {
    "key": "shift+space",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "insertSpaceAndCursorLeft (shift+space)",
      "command": "runCommands",
      "commandArgs": {
        "commands": [
          {
            "command": "type",
            "args": { "text": " " },
          },
          "cursorLeft",
        ],
      },
      "priority": "tertiary",
      "group": "text-editing/history-save-aux",
    },
    "when": "editorTextFocus && !editorReadonly && !isComposing",
  },
  {
    "key": "alt+u",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "undo (alt+u)",
      "command": "undo",
      "priority": "primary",
      "group": "text-editing/history-save-aux",
    },
  },
  {
    "key": "shift+alt+u",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "redo (shift+alt+u)",
      "command": "redo",
      "priority": "primary",
      "group": "text-editing/history-save-aux",
    },
  },
  {
    "key": "ctrl+alt+s",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "saveAll (ctrl+alt+s)",
      "command": "saveAll",
      "priority": "secondary",
      "group": "text-editing/history-save-aux",
    },
  },
  //#endregion

  //#region Module 4: 【クイック検索 & トグル復元】
  // 4-1. 検索・置換の起動
  {
    "key": "alt+s",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "actions.find (alt+s)",
      "command": "actions.find",
      "priority": "primary",
      "group": "quick-search/widget-toggle",
    },
    "when": "(editorFocus || editorIsOpen) && !selectionAnchorSet",
  },
  {
    "key": "alt+s",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "closeFindWidget (alt+s)",
      "command": "closeFindWidget",
      "priority": "primary",
      "group": "quick-search/widget-toggle",
    },
    "when": "findWidgetVisible && !isComposing && (findInputFocussed || replaceInputFocussed)",
  },
  {
    "key": "shift+alt+s",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.startFindReplaceAction (shift+alt+s)",
      "command": "editor.action.startFindReplaceAction",
      "priority": "primary",
      "group": "quick-search/widget-toggle",
    },
    "when": "(editorFocus || editorIsOpen) && !selectionAnchorSet",
  },

  // 4-2. 検索内ナビゲーション
  {
    "key": "alt+k",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.previousMatchFindAction (alt+k)",
      "command": "editor.action.previousMatchFindAction",
      "priority": "primary",
      "group": "quick-search/match-navigation",
    },
    "when": "editorFocus && findInputFocussed",
  },
  {
    "key": "alt+j",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.nextMatchFindAction (alt+j)",
      "command": "editor.action.nextMatchFindAction",
      "priority": "primary",
      "group": "quick-search/match-navigation",
    },
    "when": "editorFocus && findInputFocussed",
  },

  // 4-3. 定義・参照・コードジャンプ
  {
    "key": "alt+g",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.peekDefinition (alt+g)",
      "command": "editor.action.peekDefinition",
      "priority": "primary",
      "group": "quick-search/symbol-jump",
    },
    "when": "editorHasDefinitionProvider && editorTextFocus && !referenceSearchVisible && !inReferenceSearchEditor && !isInEmbeddedEditor && !suggestWidgetVisible",
  },
  {
    "key": "shift+alt+g",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "togglePeekWidgetFocus (shift+alt+g)",
      "command": "togglePeekWidgetFocus",
      "priority": "secondary",
      "group": "quick-search/symbol-jump",
    },
    "when": "referenceSearchVisible",
  },
  {
    "key": "shift+alt+g",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.goToImplementation (shift+alt+g)",
      "command": "editor.action.goToImplementation",
      "priority": "secondary",
      "group": "quick-search/symbol-jump",
    },
    "when": "editorHasImplementationProvider && editorTextFocus && !referenceSearchVisible && !inReferenceSearchEditor && !isInEmbeddedEditor",
  },
  {
    "key": "ctrl+alt+g",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.goToReferences (ctrl+alt+g)",
      "command": "editor.action.goToReferences",
      "priority": "primary",
      "group": "quick-search/symbol-jump",
    },
    "when": "editorHasReferenceProvider && editorTextFocus && !referenceSearchVisible && !inReferenceSearchEditor && !isInEmbeddedEditor",
  },
  {
    "key": "ctrl+shift+alt+g",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.revealDefinitionAside (ctrl+shift+alt+g)",
      "command": "editor.action.revealDefinitionAside",
      "priority": "secondary",
      "group": "quick-search/symbol-jump",
    },
    "when": "editorHasDefinitionProvider && editorTextFocus && !isInEmbeddedEditor",
  },

  // 4-4. 検索オプション・トグル復元 (Alt+F W / R / C / L)
  {
    "key": "alt+f alt+w",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "toggleSearchEditorWholeWord (alt+f alt+w)",
      "command": "toggleSearchEditorWholeWord",
      "priority": "secondary",
      "group": "quick-search/option-toggle",
    },
    "when": "inSearchEditor && searchInputBoxFocus",
  },
  {
    "key": "alt+f alt+w",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "toggleFindWholeWord (alt+f alt+w)",
      "command": "toggleFindWholeWord",
      "priority": "secondary",
      "group": "quick-search/option-toggle",
    },
    "when": "editorFocus",
  },
  {
    "key": "alt+f alt+w",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "toggleSearchWholeWord (alt+f alt+w)",
      "command": "toggleSearchWholeWord",
      "priority": "secondary",
      "group": "quick-search/option-toggle",
    },
    "when": "searchViewletFocus",
  },
  {
    "key": "alt+f alt+r",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "toggleFindRegex (alt+f alt+r)",
      "command": "toggleFindRegex",
      "priority": "secondary",
      "group": "quick-search/option-toggle",
    },
    "when": "editorFocus",
  },
  {
    "key": "alt+f alt+r",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "toggleSearchRegex (alt+f alt+r)",
      "command": "toggleSearchRegex",
      "priority": "secondary",
      "group": "quick-search/option-toggle",
    },
    "when": "searchViewletFocus",
  },
  {
    "key": "alt+f alt+r",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.action.chat.toggleFindRegex (alt+f alt+r)",
      "command": "workbench.action.chat.toggleFindRegex",
      "priority": "secondary",
      "group": "quick-search/option-toggle",
    },
    "when": "chatFindWidgetVisible",
  },
  {
    "key": "alt+f alt+c",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "toggleFindCaseSensitive (alt+f alt+c)",
      "command": "toggleFindCaseSensitive",
      "priority": "secondary",
      "group": "quick-search/option-toggle",
    },
    "when": "editorFocus",
  },
  {
    "key": "alt+f alt+c",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "toggleSearchCaseSensitive (alt+f alt+c)",
      "command": "toggleSearchCaseSensitive",
      "priority": "secondary",
      "group": "quick-search/option-toggle",
    },
    "when": "searchViewletFocus",
  },
  {
    "key": "alt+f alt+c",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.action.chat.toggleFindCaseSensitive (alt+f alt+c)",
      "command": "workbench.action.chat.toggleFindCaseSensitive",
      "priority": "secondary",
      "group": "quick-search/option-toggle",
    },
    "when": "chatFindWidgetVisible",
  },
  {
    "key": "alt+f alt+l",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "toggleFindInSelection (alt+f alt+l)",
      "command": "toggleFindInSelection",
      "priority": "secondary",
      "group": "quick-search/option-toggle",
    },
    "when": "editorFocus && findInputFocussed",
  },
  //#endregion

  //#region Module 5: 【ユニバーサル決定 (Alt+M)】
  // 5-1. UI・ポップアップ確定
  {
    "key": "alt+m",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "acceptSelectedSuggestion (alt+m)",
      "command": "acceptSelectedSuggestion",
      "priority": "primary",
      "group": "universal-confirm/ui-commit",
    },
    "when": "acceptSuggestionOnEnter && suggestWidgetHasFocusedSuggestion && suggestWidgetVisible && suggestionMakesTextEdit && textInputFocus",
  },
  {
    "key": "alt+m",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "acceptSelectedCodeAction (alt+m)",
      "command": "acceptSelectedCodeAction",
      "priority": "primary",
      "group": "universal-confirm/ui-commit",
    },
    "when": "codeActionMenuVisible",
  },
  {
    "key": "alt+m",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "acceptRenameInput (alt+m)",
      "command": "acceptRenameInput",
      "priority": "primary",
      "group": "universal-confirm/ui-commit",
    },
    "when": "editorFocus && renameInputVisible && !isComposing",
  },
  {
    "key": "alt+m",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "workbench.action.acceptSelectedQuickOpenItem (alt+m)",
      "command": "workbench.action.acceptSelectedQuickOpenItem",
      "priority": "primary",
      "group": "universal-confirm/ui-commit",
    },
    "when": "inQuickOpen",
  },
  {
    "key": "alt+m",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "editor.action.replaceAll (alt+m)",
      "command": "editor.action.replaceAll",
      "priority": "secondary",
      "group": "universal-confirm/ui-commit",
    },
    "when": "editorFocus && replaceInputFocussed",
  },

  // 5-2. リスト・エクスプローラー決定
  {
    "key": "alt+m",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "list.select (alt+m)",
      "command": "list.select",
      "priority": "primary",
      "group": "universal-confirm/list-commit",
    },
    "when": "!treeElementCanExpand && !treeElementCanCollapse && listFocus && !filesExplorerFocus && !referenceSearchVisible && !inputFocus && !treestickyScrollFocused",
  },
  {
    "key": "alt+m",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "openReferenceAndClose (alt+m)",
      "command": "runCommands",
      "commandArgs": {
        "commands": ["openReference", "closeReferenceSearch"],
      },
      "priority": "secondary",
      "group": "universal-confirm/list-commit",
      "keep": true,
    },
    "when": "listFocus && referenceSearchVisible && !inputFocus",
  },
  {
    "key": "alt+m",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "list.toggleExpand (alt+m)",
      "command": "list.toggleExpand",
      "priority": "primary",
      "group": "universal-confirm/list-commit",
    },
    "when": "(treeElementCanExpand || treeElementCanCollapse) && listFocus && !inputFocus && !treestickyScrollFocused",
  },
  {
    "key": "shift+alt+m",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "list.toggleSelection (shift+alt+m)",
      "command": "list.toggleSelection",
      "priority": "secondary",
      "group": "universal-confirm/list-commit",
    },
    "when": "listFocus && !inputFocus && !treestickyScrollFocused",
  },
  {
    "key": "alt+m",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "filesExplorer.openFilePreserveFocus (alt+m)",
      "command": "filesExplorer.openFilePreserveFocus",
      "priority": "primary",
      "group": "universal-confirm/list-commit",
    },
    "when": "filesExplorerFocus && !explorerResourceIsFolder && !inputFocus",
  },
  {
    "key": "ctrl+alt+m",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "openAndCloseSidebar (ctrl+alt+m)",
      "command": "runCommands",
      "commandArgs": {
        "commands": ["list.select", "workbench.action.closeSidebar"],
      },
      "priority": "secondary",
      "group": "universal-confirm/list-commit",
    },
    "when": "filesExplorerFocus && !inputFocus",
  },
  //#endregion

  //#region Module 6: 【ユニバーサル脱出 (Alt+E)】
  {
    "key": "alt+e",
    "command": "myTracker.trackAndRun",
    "args": {
      "keyName": "noop (alt+e)",
      "command": "noop",
      "priority": "tertiary",
      "group": "universal-escape/fallback",
    },
    "when": "textInputFocus && !selectionAnchorSet",
